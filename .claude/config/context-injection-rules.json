  "runtime_agent_constraints": {
    "_comment": "Shared runtime constraints. These are intended to mirror the project constitution and pipeline contract.",
    "global_prohibitions": [
      "Do not issue buy recommendations.",
      "Do not issue sell recommendations.",
      "Do not provide direct investment instructions.",
      "Do not propose portfolio weighting decisions.",
      "Do not trigger real trading actions."
    ],
    "final_statement_rule": "The final IP-stage statement must preserve uncertainty and avoid presenting speculative conclusions as certain facts.",
    "data_flow_direction": "NC -> NF -> NT -> CA -> TC -> TR -> IS -> IA -> IP",
    "pipeline_reference": ".claude/config/PIPELINE.md"
  },

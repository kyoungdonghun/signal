    "llm_inference_config": {
      "search_scope": [
        "docs/*",
        ".claude/agents/runtime/*",
        ".claude/config/*"
      ],
      "exclude_from_inference": [
        "docs/references/*",
        ".claude/config/afterSource.md"
      ],
      "max_additional_docs": 5,
      "instruction": "Analyze the current SIGNAL task context. Always preserve the rule that runtime agents under .claude/agents/runtime/ must not issue buy or sell recommendations. Return the relevant document paths."
    }

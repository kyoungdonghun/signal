{
  "triggers": [
    {
      "category": "Security Policy",
      "regex": "password|비밀번호|security|보안|secret|token|key|api.?key|reset|credential|인증",
      "load": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "category": "Database Standards",
      "regex": "database|데이터베이스|schema|스키마|db|sql|migration|마이그레이션|jpa|entity|엔티티",
      "load": [
        "AGENTS.md",
        ".claude/config/PIPELINE.md"
      ]
    },
    {
      "category": "Versioning And Deployment",
      "regex": "deploy|배포|production|프로덕션|release|릴리즈|version|버전|gradle|빌드|build",
      "load": [
        "AGENTS.md"
      ]
    },
    {
      "category": "Documentation Standards",
      "regex": "prd|spec|document|문서|write|작성|template|템플릿|requirement|요구사항",
      "load": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "category": "Build Layer",
      "regex": "구현|implement|code|코드|review|리뷰|test|테스트|architecture|설계|ui|ux|documentation|문서|security|보안",
      "load": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "category": "Agent System",
      "regex": "subagent|서브에이전트|skill|skills|routing|라우팅|build.?layer|runtime.?layer|에이전트",
      "load": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "category": "Execution And HITL Policy",
      "regex": "execute|실행|command|명령|approval|승인|HITL|tool|권한",
      "load": [
        "AGENTS.md",
        "CLAUDE.md"
      ]
    },
    {
      "category": "Market Data Pipeline",
      "regex": "yahoo|yfinance|ohlcv|시가|고가|저가|종가|거래량|price|가격|market.?data|시장.?데이터|주가",
      "load": [
        ".claude/config/PIPELINE.md",
        ".claude/agents/runtime/tc.md"
      ]
    },
    {
      "category": "News Pipeline",
      "regex": "rss|뉴스|news|feed|수집|collect|reuters|bloomberg|공시|dart|edgar",
      "load": [
        ".claude/agents/runtime/nc.md",
        ".claude/agents/runtime/nf.md",
        ".claude/agents/runtime/nt.md"
      ]
    },
    {
      "category": "Technical Analysis",
      "regex": "ma|이동평균|moving.?average|rsi|거래량|volume|기술.?분석|technical.?analysis|지표|indicator|과매수|과매도",
      "load": [
        ".claude/agents/runtime/tc.md",
        ".claude/agents/runtime/tr.md"
      ]
    },
    {
      "category": "Cross Validation And Briefing",
      "regex": "교차검증|cross|충돌|conflict|일치|aligned|브리핑|briefing|요약|summary|ca|aggregate",
      "load": [
        ".claude/agents/runtime/ca.md",
        ".claude/agents/runtime/is.md",
        ".claude/agents/runtime/ia.md",
        ".claude/agents/runtime/ip.md"
      ]
    },
    {
      "category": "Claude API Integration",
      "regex": "claude.?api|sentiment|감성.?분석|ai.?분석|system.?prompt|프롬프트|llm|태깅|tagging",
      "load": [
        ".claude/agents/runtime/nt.md",
        ".claude/agents/runtime/is.md"
      ]
    },
    {
      "category": "Pipeline Full Flow",
      "regex": "파이프라인|pipeline|전체.?흐름|full.?flow|phase.?1|phase1|nc.*ip|ni.*ib",
      "load": [
        ".claude/config/PIPELINE.md"
      ]
    },
    {
      "category": "Future Enhancement",
      "regex": "고도화|enhancement|phase.?[234]|after.?source|지식.?그래프|knowledge.?graph|백테스팅|backtesting|포트폴리오|portfolio",
      "load": [
        ".claude/config/afterSource.md"
      ]
    }
  ]
}
